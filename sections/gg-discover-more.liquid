{% comment %}
  Section: GG Discover More
  File: sections/gg-discover-more.liquid
  Description: Two-tab product carousel. Tab 1 (MORE FROM THIS BRAND) is server-rendered from a
               merchant-selected collection. Tab 2 (TEAM UP WITH) is JS-fetched via recommendations API.
               CSS scroll-snap carousel with skewed prev/next arrow JS controls. No external JS libs.
{% endcomment %}

{%- assign brand_col      = collections[section.settings.brand_collection] -%}
{%- assign has_brand_tab  = false -%}
{%- if section.settings.brand_collection != blank and brand_col != blank and brand_col.products.size > 0 -%}
  {%- assign has_brand_tab = true -%}
{%- endif -%}
{%- assign discover_limit = section.settings.products_to_show | default: 8 -%}

<section
  class="gg-section gg-discover"
  id="gg-discover-{{ section.id }}"
  data-section-id="{{ section.id }}"
  data-product-id="{{ product.id }}"
  data-limit="{{ discover_limit }}"
  aria-label="{{ section.settings.heading | default: 'DISCOVER MORE' }}"
>

  <div class="gg-discover__inner">

    <div class="gg-sec-head">
      <h2 class="gg-sec-head__title">{{ section.settings.heading | default: 'DISCOVER MORE' | upcase }}</h2>
    </div>

    {%- comment %} Tab bar {%- endcomment %}
    <div class="gg-discover__tabs" role="tablist">

      {%- if has_brand_tab -%}
        <button
          class="gg-discover__tab is-active"
          role="tab"
          aria-selected="true"
          aria-controls="gg-discover-panel-brand-{{ section.id }}"
          id="gg-discover-tab-brand-{{ section.id }}"
          data-tab="brand"
          type="button"
        >
          {{ section.settings.brand_tab_label | default: 'MORE FROM THIS BRAND' | upcase }}
        </button>
      {%- endif -%}

      <button
        class="gg-discover__tab{% unless has_brand_tab %} is-active{% endunless %}"
        role="tab"
        aria-selected="{% if has_brand_tab %}false{% else %}true{% endif %}"
        aria-controls="gg-discover-panel-team-{{ section.id }}"
        id="gg-discover-tab-team-{{ section.id }}"
        data-tab="team"
        type="button"
      >
        {{ section.settings.team_tab_label | default: 'TEAM UP WITH' | upcase }}
      </button>

    </div>

    {%- comment %} ===== TAB 1: MORE FROM THIS BRAND (Liquid-rendered) ===== {%- endcomment %}
    {%- if has_brand_tab -%}
      <div
        class="gg-discover__panel is-active"
        role="tabpanel"
        id="gg-discover-panel-brand-{{ section.id }}"
        aria-labelledby="gg-discover-tab-brand-{{ section.id }}"
        data-panel="brand"
      >
        <div class="gg-discover__carousel-outer">

          <button class="gg-discover__arrow gg-discover__arrow--prev is-hidden-arrow" type="button" aria-label="Previous products">
            <span aria-hidden="true">&#8592;</span>
          </button>

          <div class="gg-discover__track" role="list">
            {%- for prod in brand_col.products limit: discover_limit -%}
              {%- assign is_exclusive = false -%}
              {%- if prod.tags contains 'exclusive' -%}{%- assign is_exclusive = true -%}{%- endif -%}
              {%- assign is_on_sale = false -%}
              {%- if prod.compare_at_price > prod.price -%}{%- assign is_on_sale = true -%}{%- endif -%}
              {%- assign prod_img_alt = prod.featured_image.alt | default: prod.title | escape -%}
              <a href="{{ prod.url }}" class="gg-discover__card" role="listitem" aria-label="{{ prod.title | escape }}">
                <div class="gg-discover__card-thumb">
                  {%- if prod.featured_image -%}
                    {{- prod.featured_image | image_url: width: 600, format: 'webp' | image_tag:
                          loading: 'lazy',
                          alt: prod_img_alt,
                          width: 600,
                          height: 600 -}}
                  {%- else -%}
                    <span class="gg-discover__card-placeholder" aria-hidden="true">🏋️</span>
                  {%- endif -%}
                  {%- if is_on_sale -%}
                    <span class="gg-product-card__badge gg-product-card__badge--sale">SALE</span>
                  {%- endif -%}
                  {%- if is_exclusive -%}
                    <span class="gg-product-card__badge gg-product-card__badge--exclusive">EXCLUSIVE</span>
                  {%- endif -%}
                </div>
                <div class="gg-discover__card-body">
                  <span class="gg-discover__card-title">{{ prod.title | upcase }}</span>
                  <div class="gg-discover__card-price">
                    {%- if is_on_sale -%}
                      <span class="gg-discover__price-sale">{{ prod.price | money }}</span>
                      <span class="gg-discover__price-was">{{ prod.compare_at_price | money }}</span>
                    {%- else -%}
                      <span class="gg-discover__price-sale">{{ prod.price | money }}</span>
                    {%- endif -%}
                  </div>
                </div>
              </a>
            {%- endfor -%}
          </div>

          <button class="gg-discover__arrow gg-discover__arrow--next" type="button" aria-label="Next products">
            <span aria-hidden="true">&#8594;</span>
          </button>

        </div>
      </div>
    {%- endif -%}

    {%- comment %} ===== TAB 2: TEAM UP WITH (JS-fetched) ===== {%- endcomment %}
    <div
      class="gg-discover__panel{% unless has_brand_tab %} is-active{% endunless %}"
      role="tabpanel"
      id="gg-discover-panel-team-{{ section.id }}"
      aria-labelledby="gg-discover-tab-team-{{ section.id }}"
      data-panel="team"
      {% if has_brand_tab %}style="display:none"{% endif %}
    >
      <div class="gg-discover__carousel-outer">

        <button class="gg-discover__arrow gg-discover__arrow--prev is-hidden-arrow" type="button" aria-label="Previous products">
          <span aria-hidden="true">&#8592;</span>
        </button>

        <div class="gg-discover__track gg-discover__track--team" role="list">
          {%- comment %} Skeleton shimmer cards — shown while JS fetches {%- endcomment %}
          {%- for i in (1..4) -%}
            <div class="gg-discover__card gg-discover__card--skeleton" aria-hidden="true">
              <div class="gg-discover__card-thumb gg-shimmer"></div>
              <div class="gg-discover__card-body">
                <div class="gg-shimmer gg-shimmer--text" style="height:16px; width:75%; margin-bottom:8px;"></div>
                <div class="gg-shimmer gg-shimmer--text" style="height:18px; width:40%;"></div>
              </div>
            </div>
          {%- endfor -%}
        </div>

        <button class="gg-discover__arrow gg-discover__arrow--next" type="button" aria-label="Next products">
          <span aria-hidden="true">&#8594;</span>
        </button>

      </div>
    </div>

  </div>

</section>

<script type="module">
  (function() {
    const section   = document.getElementById('gg-discover-{{ section.id }}');
    if (!section) return;

    const productId = section.dataset.productId;
    const limit     = parseInt(section.dataset.limit, 10) || 8;

    // ---- Tab switching ----
    const tabs   = Array.from(section.querySelectorAll('.gg-discover__tab'));
    const panels = Array.from(section.querySelectorAll('.gg-discover__panel'));

    tabs.forEach(function(tab) {
      tab.addEventListener('click', function() {
        const targetId = tab.getAttribute('aria-controls');

        tabs.forEach(function(t) {
          t.classList.remove('is-active');
          t.setAttribute('aria-selected', 'false');
        });
        tab.classList.add('is-active');
        tab.setAttribute('aria-selected', 'true');

        panels.forEach(function(panel) {
          if (panel.id === targetId) {
            panel.classList.add('is-active');
            panel.style.display = '';
            // Lazy-load team tab
            if (panel.dataset.panel === 'team' && !panel.dataset.loaded) {
              fetchTeamProducts(panel);
            }
            // Refresh arrow visibility after reveal
            setTimeout(function() { updateArrows(panel); }, 50);
          } else {
            panel.classList.remove('is-active');
            panel.style.display = 'none';
          }
        });
      });
    });

    // ---- Init carousels for initially visible panels ----
    panels.forEach(function(panel) {
      if (panel.classList.contains('is-active')) {
        initCarousel(panel);
        if (panel.dataset.panel === 'team') {
          fetchTeamProducts(panel);
        }
      }
    });

    // ---- Carousel init ----
    function initCarousel(panel) {
      const outer    = panel.querySelector('.gg-discover__carousel-outer');
      const track    = panel.querySelector('.gg-discover__track');
      const prevBtn  = panel.querySelector('.gg-discover__arrow--prev');
      const nextBtn  = panel.querySelector('.gg-discover__arrow--next');
      if (!track || !prevBtn || !nextBtn) return;

      prevBtn.addEventListener('click', function() {
        const cardWidth = getCardWidth(track);
        track.scrollBy({ left: -cardWidth, behavior: 'smooth' });
      });

      nextBtn.addEventListener('click', function() {
        const cardWidth = getCardWidth(track);
        track.scrollBy({ left: cardWidth, behavior: 'smooth' });
      });

      track.addEventListener('scroll', function() {
        updateArrowsForTrack(track, prevBtn, nextBtn);
      }, { passive: true });

      updateArrowsForTrack(track, prevBtn, nextBtn);
    }

    function updateArrows(panel) {
      const track   = panel.querySelector('.gg-discover__track');
      const prevBtn = panel.querySelector('.gg-discover__arrow--prev');
      const nextBtn = panel.querySelector('.gg-discover__arrow--next');
      if (track && prevBtn && nextBtn) updateArrowsForTrack(track, prevBtn, nextBtn);
    }

    function updateArrowsForTrack(track, prevBtn, nextBtn) {
      const atStart = track.scrollLeft <= 4;
      const atEnd   = track.scrollLeft + track.clientWidth >= track.scrollWidth - 4;
      prevBtn.classList.toggle('is-hidden-arrow', atStart);
      nextBtn.classList.toggle('is-hidden-arrow', atEnd);
    }

    function getCardWidth(track) {
      const firstCard = track.querySelector('.gg-discover__card:not(.gg-discover__card--skeleton)') ||
                        track.querySelector('.gg-discover__card');
      if (!firstCard) return 260;
      return firstCard.getBoundingClientRect().width + 16; // card + gap
    }

    // ---- Team Up With fetch (lazy) ----
    function fetchTeamProducts(panel) {
      panel.dataset.loaded = 'true'; // prevent re-fetch

      const track = panel.querySelector('.gg-discover__track--team');
      if (!track || !productId) return;

      const compUrl     = '/recommendations/products.json?product_id=' + productId + '&limit=' + limit + '&intent=complementary';
      const relatedUrl  = '/recommendations/products.json?product_id=' + productId + '&limit=' + limit + '&intent=related';

      function fetchRecs(u) {
        return fetch(u, { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
          .then(function(res) {
            if (!res.ok) throw new Error('Recommendations failed');
            return res.json();
          })
          .then(function(data) { return data.products || []; });
      }

      fetchRecs(compUrl)
        .then(function(products) {
          if (!products || products.length === 0) return fetchRecs(relatedUrl);
          return products;
        })
        .then(function(products) {
          if (!products || products.length === 0) {
            track.innerHTML = '<p style="color:var(--steel);font-family:Archivo Narrow,sans-serif;padding:24px 0;">No related products found.</p>';
            return;
          }

          const cards = products.map(function(p) {
            const img        = (p.images && p.images[0]) ? p.images[0] : null;
            const imageUrl   = img ? img.src.replace(/(_\d+x\d*(_crop_\w+)?)?(\?.*)?$/, '') + '?width=600&format=webp' : '';
            const alt        = (img && img.alt) ? escapeHtml(img.alt) : escapeHtml(p.title);
            const isOnSale   = p.compare_at_price_max && p.compare_at_price_max > p.price;
            const isExclusive = p.tags && p.tags.includes('exclusive');

            const imgHtml = imageUrl
              ? '<img src="' + imageUrl + '" alt="' + alt + '" loading="lazy" width="600" height="600">'
              : '<span class="gg-discover__card-placeholder" aria-hidden="true">\uD83C\uDFCB\uFE0F</span>';

            const saleBadge      = isOnSale   ? '<span class="gg-product-card__badge gg-product-card__badge--sale">SALE</span>' : '';
            const exclusiveBadge = isExclusive ? '<span class="gg-product-card__badge gg-product-card__badge--exclusive">EXCLUSIVE</span>' : '';

            const priceHtml = isOnSale
              ? '<span class="gg-discover__price-sale">' + formatMoney(p.price) + '</span><span class="gg-discover__price-was">' + formatMoney(p.compare_at_price_max) + '</span>'
              : '<span class="gg-discover__price-sale">' + formatMoney(p.price) + '</span>';

            return '<a href="' + p.url + '" class="gg-discover__card" role="listitem" aria-label="' + escapeHtml(p.title) + '">' +
              '<div class="gg-discover__card-thumb">' + imgHtml + saleBadge + exclusiveBadge + '</div>' +
              '<div class="gg-discover__card-body">' +
                '<span class="gg-discover__card-title">' + escapeHtml(p.title).toUpperCase() + '</span>' +
                '<div class="gg-discover__card-price">' + priceHtml + '</div>' +
              '</div>' +
            '</a>';
          });

          track.innerHTML = cards.join('');

          // Re-init carousel arrows now that real cards are in the DOM
          initCarousel(panel);
          setTimeout(function() { updateArrows(panel); }, 50);
        })
        .catch(function() {
          track.innerHTML = '<p style="color:var(--steel);font-family:Archivo Narrow,sans-serif;padding:24px 0;">Could not load recommendations.</p>';
        });
    }

    function formatMoney(cents) {
      return new Intl.NumberFormat('en-AU', { style: 'currency', currency: 'AUD' }).format(cents / 100);
    }

    function escapeHtml(str) {
      if (!str) return '';
      return String(str).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
    }
  })();
</script>

{% schema %}
{
  "name": "GG — Discover More",
  "tag": "section",
  "class": "gg-section-discover-more",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section heading",
      "default": "DISCOVER MORE"
    },
    {
      "type": "text",
      "id": "brand_tab_label",
      "label": "Brand tab label",
      "default": "MORE FROM THIS BRAND"
    },
    {
      "type": "text",
      "id": "team_tab_label",
      "label": "Team tab label",
      "default": "TEAM UP WITH"
    },
    {
      "type": "collection",
      "id": "brand_collection",
      "label": "Brand collection",
      "info": "Products from this collection appear in the 'More From This Brand' tab. Leave blank to show only the 'Team Up With' tab."
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Max products per tab",
      "min": 4,
      "max": 12,
      "step": 1,
      "default": 8
    }
  ],
  "presets": [
    {
      "name": "GG — Discover More"
    }
  ]
}
{% endschema %}
