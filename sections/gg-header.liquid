{% comment %}
  Section: GG Header
  File: sections/gg-header.liquid
  Description: Full-width sticky nav with multi-column mega menu dropdowns (desktop)
               and accordion slide-in drawer (mobile). Hides on scroll-down,
               reveals on scroll-up.
{% endcomment %}

<style>
  /* ============================================================
     MEGA MENU
     Scoped to .gg-mega — all other nav CSS lives in garagegains.css
     ============================================================ */

  .gg-mega {
    position: fixed;
    top: 68px;
    left: 0;
    right: 0;
    background: rgba(10,10,10,0.97);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-top: 2px solid var(--ember);
    border-bottom: 1px solid var(--border);
    opacity: 0;
    transform: translateY(-8px);
    pointer-events: none;
    transition: opacity 0.2s ease-out, transform 0.2s ease-out;
    z-index: 201;
  }

  .gg-mega.is-open {
    opacity: 1;
    transform: translateY(0);
    pointer-events: all;
  }

  .gg-mega__inner {
    max-width: 1440px;
    margin: 0 auto;
    padding: 48px 80px 52px;
    display: flex;
    gap: 48px;
    align-items: flex-start;
  }

  .gg-mega__cols {
    display: flex;
    gap: 40px;
    flex: 1;
    flex-wrap: wrap;
  }

  .gg-mega__col {
    flex: 1;
    min-width: 140px;
  }

  .gg-mega__col-head {
    display: block;
    font-family: 'Barlow Condensed', sans-serif;
    font-weight: 800;
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: rgba(245,243,239,0.5);
    text-decoration: none;
    margin-bottom: 16px;
    transition: color 0.2s;
  }

  .gg-mega__col-head:hover {
    color: var(--ember);
  }

  .gg-mega__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .gg-mega__link {
    display: block;
    font-family: 'DM Sans', sans-serif;
    font-weight: 400;
    font-size: 14px;
    color: rgba(245,243,239,0.65);
    text-decoration: none;
    padding: 2px 0;
    transition: color 0.2s, padding-left 0.2s;
  }

  .gg-mega__link:hover {
    color: var(--bone);
    padding-left: 4px;
  }

  /* Direct links (no grandchildren) rendered in a "featured" first column */
  .gg-mega__featured-col {
    flex: 1;
    min-width: 160px;
  }

  .gg-mega__featured-link {
    display: block;
    font-family: 'DM Sans', sans-serif;
    font-weight: 500;
    font-size: 15px;
    color: var(--bone);
    text-decoration: none;
    padding: 6px 0;
    border-bottom: 1px solid var(--border);
    transition: color 0.2s, padding-left 0.2s;
  }

  .gg-mega__featured-link:last-child {
    border-bottom: none;
  }

  .gg-mega__featured-link:hover {
    color: var(--ember);
    padding-left: 4px;
  }

  /* Nav link chevron */
  .gg-nav__link--has-children::after {
    content: '';
    display: inline-block;
    width: 6px;
    height: 6px;
    border-right: 1.5px solid currentColor;
    border-bottom: 1.5px solid currentColor;
    transform: rotate(45deg) translateY(-2px);
    margin-left: 6px;
    opacity: 0.5;
    transition: transform 0.2s, opacity 0.2s;
    vertical-align: middle;
  }

  .gg-nav__item.is-open .gg-nav__link--has-children::after {
    transform: rotate(-135deg) translateY(-2px);
    opacity: 1;
  }

  /* ============================================================
     DRAWER ACCORDION (mobile)
     New rules only — base drawer panel CSS is in garagegains.css
     ============================================================ */

  .gg-drawer__item {
    border-bottom: 1px solid var(--border);
  }

  .gg-drawer__item:last-child {
    border-bottom: none;
  }

  /* Row containing the link label + toggle icon */
  .gg-drawer__row {
    display: flex;
    align-items: stretch;
  }

  /* The actual navigation link (left side of row) */
  .gg-drawer__row-link {
    flex: 1;
    display: block;
    padding: 14px 0 14px 24px;
    font-family: 'Barlow Condensed', sans-serif;
    font-weight: 800;
    font-size: 22px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: rgba(245,243,239,0.4);
    text-decoration: none;
    transition: color 0.2s;
  }

  .gg-drawer__row-link:hover {
    color: var(--bone);
  }

  .gg-drawer__row-link--sale { color: var(--ember); }
  .gg-drawer__row-link--sale:hover { color: var(--ember-hover); }

  /* Accordion toggle button (right side of row, only when children exist) */
  .gg-drawer__toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 52px;
    flex-shrink: 0;
    background: none;
    border: none;
    color: var(--ember);
    font-size: 20px;
    cursor: pointer;
    padding: 0;
    line-height: 1;
    transition: transform 0.25s ease;
  }

  .gg-drawer__toggle[aria-expanded="true"] {
    transform: rotate(45deg);
  }

  /* Sub-link container — max-height accordion */
  .gg-drawer__sub {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.3s ease;
  }

  .gg-drawer__sub.is-open {
    max-height: 600px;
  }

  /* Child heading (when grandchildren exist) */
  .gg-drawer__sub-head {
    display: block;
    padding: 10px 24px 6px 32px;
    font-family: 'Barlow Condensed', sans-serif;
    font-weight: 800;
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: rgba(245,243,239,0.35);
    text-decoration: none;
    transition: color 0.2s;
  }

  .gg-drawer__sub-head:hover {
    color: var(--ember);
  }

  /* Grandchild links */
  .gg-drawer__sub-link {
    display: block;
    padding: 7px 24px 7px 40px;
    font-family: 'DM Sans', sans-serif;
    font-size: 15px;
    font-weight: 400;
    color: rgba(245,243,239,0.55);
    text-decoration: none;
    transition: color 0.2s;
  }

  .gg-drawer__sub-link:hover {
    color: var(--bone);
  }

  /* Flat child link (no grandchildren) */
  .gg-drawer__sub-flat {
    display: block;
    padding: 9px 24px 9px 32px;
    font-family: 'DM Sans', sans-serif;
    font-size: 15px;
    font-weight: 500;
    color: rgba(245,243,239,0.6);
    text-decoration: none;
    transition: color 0.2s;
  }

  .gg-drawer__sub-flat:hover {
    color: var(--bone);
  }
</style>

{%- liquid
  assign nav_menu   = linklists[section.settings.menu]
  assign cta_label  = section.settings.cta_label | default: 'Shop Now'
  assign cta_url    = section.settings.cta_url | default: routes.collections_url
  assign logo_alt   = shop.name | escape
-%}

<!-- ===================== HEADER ===================== -->
<header class="gg-nav" id="gg-nav" role="banner">
  <div class="gg-nav__inner">

    <!-- Logo -->
    <a href="{{ routes.root_url }}" class="gg-logo" aria-label="{{ shop.name }}">
      {%- if section.settings.logo != blank -%}
        {%- assign logo_img = section.settings.logo -%}
        {{
          logo_img
          | image_url: width: 280, format: 'webp'
          | image_tag: loading: 'eager', alt: logo_alt, style: 'height:34px;width:auto;display:block;'
        }}
      {%- else -%}
        <div class="gg-logo__mark">GG</div>
        <div>
          <div class="gg-logo__name">GarageGains</div>
          <div class="gg-logo__sub">Australia</div>
        </div>
      {%- endif -%}
    </a>

    <!-- Desktop nav links -->
    <nav class="gg-nav__links" aria-label="Main navigation">
      {%- if nav_menu.links.size > 0 -%}
        {%- for link in nav_menu.links -%}
          {%- liquid
            assign has_children = false
            if link.links.size > 0
              assign has_children = true
            endif
            assign link_id = 'mega-' | append: forloop.index
          -%}
          <div
            class="gg-nav__item{% if has_children %} gg-nav__item--has-mega{% endif %}"
            {% if has_children %}
              data-mega="{{ link_id }}"
              aria-haspopup="true"
            {% endif %}
          >
            <a
              href="{{ link.url }}"
              class="gg-nav__link{% if has_children %} gg-nav__link--has-children{% endif %}{% if link.title == 'Sale' or link.title == 'SALE' %} gg-nav__link--sale{% endif %}"
              {% if link.active %}aria-current="page"{% endif %}
              {% if has_children %}
                aria-expanded="false"
                aria-controls="{{ link_id }}"
              {% endif %}
            >{{ link.title }}</a>
          </div>
        {%- endfor -%}
      {%- else -%}
        <div class="gg-nav__item">
          <a href="/collections/strength" class="gg-nav__link">Strength</a>
        </div>
        <div class="gg-nav__item">
          <a href="/collections/cardio" class="gg-nav__link">Cardio</a>
        </div>
        <div class="gg-nav__item">
          <a href="/collections/functional" class="gg-nav__link">Functional</a>
        </div>
        <div class="gg-nav__item">
          <a href="/collections/flooring-mats" class="gg-nav__link">Flooring &amp; Mats</a>
        </div>
        <div class="gg-nav__item">
          <a href="/collections/sale" class="gg-nav__link gg-nav__link--sale">Sale</a>
        </div>
        <div class="gg-nav__item">
          <a href="/pages/contact" class="gg-nav__link">Contact</a>
        </div>
      {%- endif -%}
    </nav>

    <!-- Desktop actions: search + account + cart + skewed CTA -->
    <div class="gg-nav__actions">
      <a href="{{ routes.search_url }}" class="gg-icon-btn" aria-label="Search">
        <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="11" cy="11" r="8"/>
          <path d="m21 21-4.35-4.35"/>
        </svg>
      </a>
      <a href="{{ routes.account_url }}" class="gg-icon-btn" aria-label="Account">
        <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
          <circle cx="12" cy="7" r="4"/>
        </svg>
      </a>
      <a href="{{ routes.cart_url }}" class="gg-icon-btn gg-cart-btn" aria-label="Cart ({{ cart.item_count }} items)">
        <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/>
          <line x1="3" y1="6" x2="21" y2="6"/>
          <path d="M16 10a4 4 0 0 1-8 0"/>
        </svg>
        <span class="gg-cart-count" id="cart-count">{{ cart.item_count }}</span>
      </a>
      <a href="{{ cta_url }}" class="gg-btn gg-btn--primary gg-btn--sm">
        <span class="gg-btn__label">{{ cta_label }}</span>
      </a>
    </div>

    <!-- Mobile: cart + burger -->
    <div class="gg-nav__mobile">
      <a href="{{ routes.cart_url }}" class="gg-icon-btn gg-cart-btn" aria-label="Cart ({{ cart.item_count }} items)">
        <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/>
          <line x1="3" y1="6" x2="21" y2="6"/>
          <path d="M16 10a4 4 0 0 1-8 0"/>
        </svg>
        <span class="gg-cart-count">{{ cart.item_count }}</span>
      </a>
      <button
        class="gg-burger"
        id="gg-burger"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="gg-drawer"
      >
        <span></span><span></span><span></span>
      </button>
    </div>

  </div>
</header>

<!-- ===================== MEGA MENUS ===================== -->
{%- if nav_menu.links.size > 0 -%}
  {%- for link in nav_menu.links -%}
    {%- if link.links.size > 0 -%}
      {%- assign link_id = 'mega-' | append: forloop.index -%}
      {%- liquid
        assign has_direct   = false
        assign has_columnar = false
        for child in link.links
          if child.links.size > 0
            assign has_columnar = true
          else
            assign has_direct = true
          endif
        endfor
      -%}
      <div
        class="gg-mega"
        id="{{ link_id }}"
        role="region"
        aria-label="{{ link.title }} submenu"
      >
        <div class="gg-mega__inner">

          {%- comment %} Direct-link featured column (children with no grandchildren) {%- endcomment -%}
          {%- if has_direct -%}
            <div class="gg-mega__featured-col">
              {%- for child in link.links -%}
                {%- if child.links.size == 0 -%}
                  <a href="{{ child.url }}" class="gg-mega__featured-link">{{ child.title }}</a>
                {%- endif -%}
              {%- endfor -%}
            </div>
          {%- endif -%}

          {%- comment %} Columnar children (children that have grandchildren) {%- endcomment -%}
          {%- if has_columnar -%}
            <div class="gg-mega__cols">
              {%- for child in link.links -%}
                {%- if child.links.size > 0 -%}
                  <div class="gg-mega__col">
                    <a href="{{ child.url }}" class="gg-mega__col-head">{{ child.title }}</a>
                    <ul class="gg-mega__list">
                      {%- for grandchild in child.links -%}
                        <li>
                          <a href="{{ grandchild.url }}" class="gg-mega__link">{{ grandchild.title }}</a>
                        </li>
                      {%- endfor -%}
                    </ul>
                  </div>
                {%- endif -%}
              {%- endfor -%}
            </div>
          {%- endif -%}

        </div>
      </div>
    {%- endif -%}
  {%- endfor -%}
{%- endif -%}

<!-- ===================== MOBILE DRAWER ===================== -->
<div class="gg-drawer" id="gg-drawer" role="dialog" aria-modal="true" aria-label="Navigation" aria-hidden="true">
  <div class="gg-drawer__backdrop" id="gg-backdrop"></div>
  <nav class="gg-drawer__panel">

    <div class="gg-drawer__head">
      <a href="{{ routes.root_url }}" class="gg-logo" aria-label="{{ shop.name }}">
        <div class="gg-logo__mark">GG</div>
        <div>
          <div class="gg-logo__name">GarageGains</div>
          <div class="gg-logo__sub">Australia</div>
        </div>
      </a>
      <button class="gg-drawer__close" id="gg-drawer-close" aria-label="Close menu">
        <svg width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M18 6 6 18M6 6l12 12"/>
        </svg>
      </button>
    </div>

    <div class="gg-drawer__links">
      {%- if nav_menu.links.size > 0 -%}
        {%- for link in nav_menu.links -%}
          {%- assign has_sub = false -%}
          {%- if link.links.size > 0 -%}
            {%- assign has_sub = true -%}
          {%- endif -%}
          {%- assign acc_id = 'drawer-sub-' | append: forloop.index -%}

          <div class="gg-drawer__item">
            <div class="gg-drawer__row">
              <a
                href="{{ link.url }}"
                class="gg-drawer__row-link{% if link.title == 'Sale' or link.title == 'SALE' %} gg-drawer__row-link--sale{% endif %}"
              >{{ link.title }}</a>
              {%- if has_sub -%}
                <button
                  class="gg-drawer__toggle"
                  aria-expanded="false"
                  aria-controls="{{ acc_id }}"
                  aria-label="Expand {{ link.title }}"
                >+</button>
              {%- endif -%}
            </div>

            {%- if has_sub -%}
              <div class="gg-drawer__sub" id="{{ acc_id }}">
                {%- for child in link.links -%}
                  {%- if child.links.size > 0 -%}
                    {%- comment %} Child has grandchildren — render as sub-heading + indented links {%- endcomment -%}
                    <a href="{{ child.url }}" class="gg-drawer__sub-head">{{ child.title }}</a>
                    {%- for grandchild in child.links -%}
                      <a href="{{ grandchild.url }}" class="gg-drawer__sub-link">{{ grandchild.title }}</a>
                    {%- endfor -%}
                  {%- else -%}
                    {%- comment %} Child has no grandchildren — render as flat link {%- endcomment -%}
                    <a href="{{ child.url }}" class="gg-drawer__sub-flat">{{ child.title }}</a>
                  {%- endif -%}
                {%- endfor -%}
              </div>
            {%- endif -%}
          </div>

        {%- endfor -%}
      {%- else -%}
        <div class="gg-drawer__item">
          <div class="gg-drawer__row">
            <a href="/collections/strength" class="gg-drawer__row-link">Strength</a>
          </div>
        </div>
        <div class="gg-drawer__item">
          <div class="gg-drawer__row">
            <a href="/collections/cardio" class="gg-drawer__row-link">Cardio</a>
          </div>
        </div>
        <div class="gg-drawer__item">
          <div class="gg-drawer__row">
            <a href="/collections/functional" class="gg-drawer__row-link">Functional</a>
          </div>
        </div>
        <div class="gg-drawer__item">
          <div class="gg-drawer__row">
            <a href="/collections/flooring-mats" class="gg-drawer__row-link">Flooring &amp; Mats</a>
          </div>
        </div>
        <div class="gg-drawer__item">
          <div class="gg-drawer__row">
            <a href="/collections/sale" class="gg-drawer__row-link gg-drawer__row-link--sale">Sale</a>
          </div>
        </div>
        <div class="gg-drawer__item">
          <div class="gg-drawer__row">
            <a href="/pages/contact" class="gg-drawer__row-link">Contact</a>
          </div>
        </div>
      {%- endif -%}
    </div>

    <div class="gg-drawer__footer">
      <a href="{{ cta_url }}" class="gg-btn gg-btn--primary" style="width:100%;justify-content:center;">
        <span class="gg-btn__label">{{ cta_label }}</span>
      </a>
      {%- if section.settings.support_text != blank -%}
        <p class="gg-drawer__meta">{{ section.settings.support_text }}</p>
      {%- endif -%}
    </div>

  </nav>
</div>

<script>
(function () {
  document.addEventListener('DOMContentLoaded', function () {

    /* ---------- Element refs ---------- */
    const nav      = document.getElementById('gg-nav');
    const burger   = document.getElementById('gg-burger');
    const drawer   = document.getElementById('gg-drawer');
    const backdrop = document.getElementById('gg-backdrop');
    const closeBtn = document.getElementById('gg-drawer-close');

    /* ---------- Drawer open / close ---------- */
    function openDrawer() {
      drawer.classList.add('is-open');
      drawer.setAttribute('aria-hidden', 'false');
      burger.classList.add('is-active');
      burger.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
    }
    function closeDrawer() {
      drawer.classList.remove('is-open');
      drawer.setAttribute('aria-hidden', 'true');
      burger.classList.remove('is-active');
      burger.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
    }

    burger.addEventListener('click', function () {
      drawer.classList.contains('is-open') ? closeDrawer() : openDrawer();
    });
    backdrop.addEventListener('click', closeDrawer);
    closeBtn.addEventListener('click', closeDrawer);

    /* ---------- Keyboard: Escape closes drawer and all megas ---------- */
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') {
        closeDrawer();
        closeAllMegas();
      }
    });

    /* ---------- Smart scroll: hide on down, reveal on up ---------- */
    let lastY   = 0;
    let ticking = false;

    window.addEventListener('scroll', function () {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(function () {
        const currentY = window.scrollY;
        nav.classList.toggle('scrolled', currentY > 40);
        if (currentY > 80) {
          if (currentY > lastY + 4)      { nav.classList.add('is-hidden'); }
          else if (currentY < lastY - 4) { nav.classList.remove('is-hidden'); }
        } else {
          nav.classList.remove('is-hidden');
        }
        lastY   = currentY;
        ticking = false;
      });
    }, { passive: true });

    /* ---------- Mega menu hover logic ---------- */
    let openTimeout  = null;
    let closeTimeout = null;
    let currentMega  = null;

    function closeAllMegas() {
      document.querySelectorAll('.gg-mega.is-open').forEach(function (m) {
        m.classList.remove('is-open');
      });
      document.querySelectorAll('.gg-nav__item.is-open').forEach(function (item) {
        item.classList.remove('is-open');
        const link = item.querySelector('.gg-nav__link');
        if (link) link.setAttribute('aria-expanded', 'false');
      });
      currentMega = null;
    }

    function openMega(item) {
      const megaId = item.dataset.mega;
      if (!megaId) return;
      const mega = document.getElementById(megaId);
      if (!mega) return;
      closeAllMegas();
      item.classList.add('is-open');
      mega.classList.add('is-open');
      const link = item.querySelector('.gg-nav__link');
      if (link) link.setAttribute('aria-expanded', 'true');
      currentMega = mega;
    }

    document.querySelectorAll('.gg-nav__item--has-mega').forEach(function (item) {
      item.addEventListener('mouseenter', function () {
        clearTimeout(closeTimeout);
        openTimeout = setTimeout(function () {
          openMega(item);
        }, 100);
      });

      item.addEventListener('mouseleave', function () {
        clearTimeout(openTimeout);
        closeTimeout = setTimeout(function () {
          closeAllMegas();
        }, 120);
      });
    });

    /* Keep mega open when cursor moves into the panel itself */
    document.querySelectorAll('.gg-mega').forEach(function (mega) {
      mega.addEventListener('mouseenter', function () {
        clearTimeout(closeTimeout);
      });
      mega.addEventListener('mouseleave', function () {
        closeTimeout = setTimeout(closeAllMegas, 120);
      });
    });

    /* ---------- Keyboard navigation for mega menus ---------- */
    document.querySelectorAll('.gg-nav__link--has-children').forEach(function (link) {
      link.addEventListener('keydown', function (e) {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          const item = link.closest('.gg-nav__item');
          if (item.classList.contains('is-open')) {
            closeAllMegas();
          } else {
            openMega(item);
          }
        }
      });
    });

    /* ---------- Mobile accordion ---------- */
    document.querySelectorAll('.gg-drawer__toggle').forEach(function (btn) {
      btn.addEventListener('click', function (e) {
        e.stopPropagation();
        const subId = btn.getAttribute('aria-controls');
        const sub   = document.getElementById(subId);
        if (!sub) return;
        const isExpanded = btn.getAttribute('aria-expanded') === 'true';
        if (isExpanded) {
          sub.classList.remove('is-open');
          btn.setAttribute('aria-expanded', 'false');
        } else {
          sub.classList.add('is-open');
          btn.setAttribute('aria-expanded', 'true');
        }
      });
    });

    /* ---------- Cart count: listen for cart:updated ---------- */
    document.addEventListener('cart:updated', function () {
      fetch('/cart.js')
        .then(function (r) {
          if (!r.ok) throw new Error('cart.js ' + r.status);
          return r.json();
        })
        .then(function (data) {
          document.querySelectorAll('.gg-cart-count').forEach(function (el) {
            el.textContent = data.item_count;
          });
        })
        .catch(function () { /* fail silently — counts remain stale until next navigation */ });
    });

  }); /* end DOMContentLoaded */
})();
</script>

