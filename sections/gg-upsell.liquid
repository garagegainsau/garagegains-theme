{% comment %}
  Section: GG Upsell
  File: sections/gg-upsell.liquid
  Description: "COMPLETE YOUR SETUP" related products grid.
               Fetches recommendations via Shopify's product recommendations API.
               Renders skeleton shimmer cards while loading. Hides silently if API returns nothing.
{% endcomment %}

{%- assign upsell_limit = section.settings.products_to_show | default: 4 -%}

<section
  class="gg-section gg-upsell"
  id="gg-upsell"
  data-product-id="{{ product.id }}"
  data-limit="{{ upsell_limit }}"
  aria-label="{{ section.settings.heading | default: 'COMPLETE YOUR SETUP' }}"
  style="display:none"
>

  <div class="gg-sec-head">
    {%- if section.settings.subheading != blank -%}
      <span class="gg-sec-head__label">{{ section.settings.subheading }}</span>
    {%- endif -%}
    <h2 class="gg-sec-head__title">{{ section.settings.heading | default: 'COMPLETE YOUR SETUP' | upcase }}</h2>
  </div>

  {%- comment %} Skeleton shimmer cards — shown while JS fetches recommendations {%- endcomment %}
  <div class="gg-products-grid gg-upsell__skeletons" aria-hidden="true">
    {%- for i in (1..upsell_limit) -%}
      <div class="gg-product-card gg-upsell__skeleton">
        <div class="gg-product-card__thumb gg-shimmer"></div>
        <div class="gg-product-card__body">
          <div class="gg-shimmer gg-shimmer--text" style="height:18px; width:75%; margin-bottom:12px;"></div>
          <div class="gg-shimmer gg-shimmer--text" style="height:22px; width:40%;"></div>
        </div>
      </div>
    {%- endfor -%}
  </div>

  {%- comment %} Recommendations grid — populated by JS {%- endcomment %}
  <div class="gg-products-grid gg-upsell__grid" style="display:none"></div>

</section>

<script type="module">
  (function() {
    const section    = document.getElementById('gg-upsell');
    if (!section) return;

    const productId  = section.dataset.productId;
    const limit      = parseInt(section.dataset.limit, 10) || 4;
    const skeletons  = section.querySelector('.gg-upsell__skeletons');
    const grid       = section.querySelector('.gg-upsell__grid');

    if (!productId || !grid) return;

    const url = '/recommendations/products.json?product_id=' + productId + '&limit=' + limit + '&intent=related';

    fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
      .then(function(res) {
        if (!res.ok) throw new Error('Recommendations failed');
        return res.json();
      })
      .then(function(data) {
        const products = data.products;
        if (!products || products.length === 0) {
          section.style.display = 'none';
          return;
        }

        const cards = products.map(function(p) {
          const price      = formatMoney(p.price);
          const compareAt  = p.compare_at_price_max;
          const isOnSale   = compareAt && compareAt > p.price;
          const isNew      = p.tags && p.tags.includes('new');
          const image      = (p.images && p.images[0]) ? p.images[0] : null;
          // Strip legacy Shopify CDN size suffix if present, then append width + webp format params
          const imageUrl   = image ? image.src.replace(/(_\d+x\d*(_crop_\w+)?)?(\?.*)?$/, '') + '?width=800&format=webp' : '';
          const imgSrcset  = imageUrl;
          const alt        = (image && image.alt) ? escapeHtml(image.alt) : escapeHtml(p.title);

          return '<a href="' + p.url + '" class="gg-product-card" aria-label="' + escapeHtml(p.title) + '">' +
            '<div class="gg-product-card__thumb">' +
              (imageUrl ? '<img src="' + imgSrcset + '" alt="' + alt + '" loading="lazy" width="800" height="800">' : '') +
              (isOnSale ? '<span class="gg-product-card__badge gg-product-card__badge--sale">SALE</span>' : '') +
              (isNew    ? '<span class="gg-product-card__badge gg-product-card__badge--new">NEW</span>'  : '') +
            '</div>' +
            '<div class="gg-product-card__body">' +
              '<span class="gg-product-card__title">' + escapeHtml(p.title) + '</span>' +
              '<div class="gg-product-card__footer">' +
                '<span class="gg-product-card__price">' + price +
                  (isOnSale ? '<span class="gg-product-card__was">' + formatMoney(compareAt) + '</span>' : '') +
                '</span>' +
              '</div>' +
            '</div>' +
          '</a>';
        });

        grid.innerHTML = cards.join('');
        grid.style.display = '';
        if (skeletons) skeletons.style.display = 'none';
        section.style.display = '';
      })
      .catch(function() {
        section.style.display = 'none';
      });

    function formatMoney(cents) {
      return new Intl.NumberFormat('en-AU', { style: 'currency', currency: 'AUD' }).format(cents / 100);
    }

    function escapeHtml(str) {
      if (!str) return '';
      return str.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
    }
  })();
</script>

{% schema %}
{
  "name": "GG — Upsell",
  "tag": "section",
  "class": "gg-section-upsell",
  "settings": [
    {
      "type": "text",
      "id": "subheading",
      "label": "Eyebrow label",
      "default": "RECOMMENDED FOR YOU"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Section heading",
      "default": "COMPLETE YOUR SETUP"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4,
      "info": "Shopify will return up to this many related products."
    }
  ],
  "presets": [
    {
      "name": "GG — Upsell"
    }
  ]
}
{% endschema %}
